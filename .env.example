# Copy this file to `.env` and edit the values before deploying.
# The settings module loads `.env` automatically (existing environment variables win).

# --- core ---
BLOG_SECRET_KEY=replace-with-a-long-random-string
BLOG_DEBUG=1
BLOG_ALLOWED_HOSTS=127.0.0.1,localhost
BLOG_SITE_URL=http://127.0.0.1:8000
BLOG_DEMO_MODE=1

# Set this only when the app sits behind an HTTPS reverse proxy.
# BLOG_CSRF_TRUSTED_ORIGINS=https://example.com
# BLOG_SECURE_COOKIES=1
# BLOG_SSL_REDIRECT=1
# BLOG_HSTS_SECONDS=31536000

# --- Giscus comments (optional) ---
# https://giscus.app/
BLOG_GISCUS_REPO=
BLOG_GISCUS_REPO_ID=
BLOG_GISCUS_CATEGORY=Announcements
BLOG_GISCUS_CATEGORY_ID=

# --- first-run admin (used only by seed_demo --with-admin) ---
# BLOG_ADMIN_PASSWORD=change-me-now
